{
  "issuers": {
    "https://id.example.com": {
      "org": {
        "providers": {
          "anthropic": { "key_file": "/run/secrets/org-anthropic" },
          "openai": { "key_file": "/run/secrets/org-openai" }
        },
        "models": ["example-model-*"],
        "git": [
          {
            "host": "git.example.com",
            "owner": "acme",
            "repo": "widgets",
            "write": true,
            "username": "x-access-token",
            "password_file": "/run/secrets/org-git"
          }
        ],
        "connectors": [
          {
            "id": "tracker",
            "url": "https://mcp.example.com/mcp",
            "header": "Authorization",
            "scheme": "Bearer",
            "token_file": "/run/secrets/org-tracker"
          }
        ],
        "budget": { "max_tokens": 2000000 }
      },
      "subjects": {
        "00000000-0000-4000-8000-0000000000aa": {
          "providers": {
            "anthropic": { "key_file": "/run/secrets/user-aa-anthropic" }
          },
          "models": ["example-model-large"],
          "git": [
            {
              "host": "git.example.com",
              "owner": "acme",
              "repo": "widgets",
              "write": false,
              "username": "aa-user",
              "password_file": "/run/secrets/user-aa-git"
            }
          ],
          "connectors": [
            {
              "id": "search",
              "url": "https://api.example.com/search",
              "header": "X-Api-Key",
              "scheme": "",
              "token_file": "/run/secrets/user-aa-search"
            }
          ],
          "budget": { "max_tokens": 500000 }
        }
      }
    }
  }
}
